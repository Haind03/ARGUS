  "min_score": 25,
  "min_severity": "low",
  "signal_weight_overrides": {"vssadmin_delete_shadows": 85, "mass_service_stop": 55, "rclone_copy_to_remote": 55},
  "disabled_rules": ["ARG-C2-004"]
}
