{
  "description": "Ransomware kill-chain focus: recovery inhibition, service stops, mass encryption artefacts, staging/exfil, credential theft.",
  "collector_sections": ["host", "processes", "events", "files", "defender", "registry", "shadow_copies", "network", "scheduled_tasks", "services"],
  "event_hours": 72,
  "file_scan": {"recent_days": 3, "max_files": 50000, "include_documents": true},
