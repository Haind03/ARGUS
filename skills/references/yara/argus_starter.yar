/*
  ARGUS starter YARA rules, generic, DEFENSIVE, for triage of files on the user's own machine.
  GENERATED by tools/build_yara.py, edit the spec there, not this file.
  Strings are regexes with \xNN escapes so this file is not itself mistaken for malware by AV.
  Expect false positives (security tools, browsers, scripts), treat hits as leads (score +30).
*/

rule ARGUS_PowerShell_Download_Cradle
{
    meta:
        author = "ARGUS"
        description = "PowerShell download-and-execute cradle strings"
        attack = "T1059.001"
        scope = "defensive triage"
    strings:
        $a0 = /d\x6fwn\x6coa\x64st\x72in\x67/i ascii wide
        $a1 = /d\x6fwn\x6coa\x64fi\x6ce/i ascii wide
        $a2 = /n\x65t\.\x77eb\x63li\x65nt/i ascii wide
        $a3 = /i\x6evo\x6be-\x77eb\x72eq\x75es\x74/i ascii wide
        $a4 = /s\x74ar\x74-b\x69ts\x74ra\x6esf\x65r/i ascii wide
        $b0 = /i\x6evo\x6be-\x65xp\x72es\x73io\x6e/i ascii wide
        $b1 = /i\x65x\(/i ascii wide
        $b2 = /i\x65x\s\(/i ascii wide
        $c0 = /f\x72om\x62as\x6564\x73tr\x69ng/i ascii wide
        $c1 = /-\x65nc\x6fde\x64co\x6dma\x6ed/i ascii wide
    condition:
        filesize < 50MB and (any of ($a*) and (any of ($b*) or any of ($c*)))
}

