rule ARGUS_PE_Packed_UPX
{
    meta:
        author = "ARGUS"
        description = "PE with UPX section names (packed; common in commodity malware, also in legit tools)"
        attack = "T1027.002"
    strings:
        $u0 = { 55 50 58 30 00 }
        $u1 = { 55 50 58 31 00 }
    condition:
        uint16(0) == 0x5A4D and all of ($u*)
}

rule ARGUS_LNK_Launches_Interpreter
{
    meta:
        author = "ARGUS"
        description = "Shortcut file whose target/arguments reference a script interpreter"
        attack = "T1204.002"
    strings:
        $a0 = /p\x6fwe\x72sh\x65ll/i wide ascii
        $a1 = /m\x73ht\x61/i wide ascii
        $a2 = /c\x6dd\.\x65xe/i wide ascii
        $a3 = /w\x73cr\x69pt/i wide ascii
    condition:
        uint32(0) == 0x0000004C and filesize < 2MB and any of ($a*)
}
